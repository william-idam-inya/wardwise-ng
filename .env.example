# Public browser configuration only. Obtain both values from the WardWise NG project.
VITE_SUPABASE_URL=https://YOUR_WARDWISE_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_WARDWISE_PUBLIC_KEY

# Compatibility option for older Supabase projects:
# VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# NEVER put GEMINI_API_KEY or SUPABASE_SERVICE_ROLE_KEY in a VITE_ variable.
# Gemini and privileged Supabase secrets belong in server-side function secrets.
